{
  "name": "blindtest-oiseaux",
  "version": "1.0.0",
  "description": "Blind-test de chants d'oiseaux",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.tonapp.oiseaux",
    "productName": "Blind-Test Oiseaux",
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "forceCodeSigning": false
    },
    "directories": {
      "output": "dist"
    }
  }
}
