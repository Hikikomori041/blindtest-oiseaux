{
  "author": "Nicolas BLACHÈRE <nicolas.blachere@gmail.com> (https://github.com/Hikikomori041)",
  "name": "blindtest-oiseaux",
  "version": "2.6.0",
  "description": "Blind-test de chants d'oiseaux",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "birds:check": "node tools/oiseaux.js verifier",
    "birds:collect": "node tools/oiseaux.js collecte --ouvrir",
    "birds:merge": "node tools/oiseaux.js fusion && npm run birds:prepare",
    "birds:audit": "node tools/oiseaux.js audit",
    "birds:prepare": "node scripts/run-python.js scripts/trier_json.py && node scripts/run-python.js scripts/rename_images.py && node scripts/run-python.js scripts/reencode_sons.py && node scripts/generate-birds-index.js",
    "build": "electron-builder --publish never",
    "release": "node release.js",
    "mobile:build": "node scripts/build-mobile.js && cap sync android",
    "mobile:open": "cap open android",
    "mobile:run": "node scripts/build-mobile.js && cap run android",
    "mobile:apk": "npm run mobile:build && cd android && gradlew assembleRelease",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@eslint/js": "^9.0.0",
    "bulma": "^0.9.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  },
  "build": {
    "appId": "com.nicobla.oiseaux",
    "productName": "Blind-Test Oiseaux",
    "files": [
      "**/*",
      "!birds/**",
      "!tools/**",
      "!scripts/**",
      "!.claude/**",
      "!*.md",
      "!android/**",
      "!www/**",
      "!capacitor.config.json",
      "assets/data/birds-index.json",
      "assets/images/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/images/oiseau.ico",
      "artifactName": "Blind-Test-Oiseaux-Setup-${version}.exe",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/images/oiseau.icns",
      "artifactName": "Blind-Test-Oiseaux-${version}.dmg"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.1",
    "electron-updater": "^6.6.2"
  }
}
