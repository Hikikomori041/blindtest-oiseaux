{
  "author": "Nicolas BLACHÈRE <nicolas.blachere@gmail.com> (https://github.com/Hikikomori041)",
  "name": "blindtest-oiseaux",
  "version": "2.5.0",
  "description": "Blind-test de chants d'oiseaux",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "birds:prepare": "py .\\scripts\\trier_json.py && py .\\scripts\\reencode_sons.py && node scripts/generate-birds-index.js",
    "birds:prepare:ci": "node scripts/generate-birds-index.js",
    "birds:index": "node scripts/generate-birds-index.js",
    "build": "npm run birds:prepare:ci && electron-builder --publish never",
    "build:local": "npm run birds:prepare && electron-builder --publish never",
    "release": "node release.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  },
  "build": {
    "appId": "com.nicobla.oiseaux",
    "productName": "Blind-Test Oiseaux",
    "files": [
      "**/*",
      "!birds/**",
      "assets/data/birds-index.json",
      "assets/images/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/images/oiseau.ico",
      "artifactName": "Blind-Test-Oiseaux-Setup-${version}.exe",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/images/oiseau.icns",
      "artifactName": "Blind-Test-Oiseaux-${version}.dmg"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.1",
    "electron-updater": "^6.6.2"
  }
}
